# Copy this file to ".env" (same folder as upload_lab_reports.py) and fill in the values.
# ".env" holds real passwords: never commit it. Only this ".env.example" belongs in the repo.
# Put a value in single quotes if it contains spaces or the characters # or $  (e.g. CLINIC_PASS='my#pass').

# ---- Needed for every run ----------------------------------------------------
# Login of the clinic system (ICAPP)
CLINIC_USER=
CLINIC_PASS=

# ---- Optional ----------------------------------------------------------------
# Web address of the clinic system. Leave it out to use https://indiaclinic.twinsdigital.com
# CLINIC_BASE_URL=https://indiaclinic.twinsdigital.com

# ---- Only for --drive mode (reads the Excel files from a Google Drive folder) -----
# GitHub Actions takes these two from the repository secrets, so you only need them here
# to try --drive on your own computer.
#
# GDRIVE_SA_JSON    the WHOLE contents of the service account's .json key, on ONE line, in single quotes
# DRIVE_FOLDER_ID   the part after /folders/ in the URL of the "Reports Excel" folder
#
# GDRIVE_SA_JSON='{"type": "service_account", "project_id": "...", ...}'
# DRIVE_FOLDER_ID=
